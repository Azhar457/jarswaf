# ================================================================
# jarsWAF — Lightweight Agent-Only Dockerfile
# ================================================================
# Builds ONLY the Rust binary. No Node.js, no Svelte, no Dashboard.
# Final image: ~30MB debian:bookworm-slim
# Perfect for small VPS (1 Core, 2GB RAM)
# ================================================================

FROM rust:slim-bookworm AS builder
WORKDIR /app

# Minimize disk usage
ENV CARGO_INCREMENTAL=0
ENV CARGO_BUILD_JOBS=2
ENV RUSTFLAGS="-C strip=symbols"

# Install build deps. cmake + a full C/C++ toolchain are required: libz-ng-sys invokes cmake
# and needs `c++` (g++) on PATH. Install gcc/g++/make explicitly — build-essential alone has
# been flaky here ("failed to find tool c++", "is cmake not installed?").
RUN apt-get update && \
    apt-get install -y --no-install-recommends pkg-config libssl-dev build-essential cmake gcc g++ make && \
    command -v cmake && command -v c++ && \
    rm -rf /var/lib/apt/lists/*

# Copy source
COPY Cargo.toml Cargo.lock build.rs ./
COPY proto/ ./proto/
COPY xtask/ ./xtask/
COPY src/ ./src/

# Build release binary
RUN cargo build --release && \
    cp target/release/jarswaf /app/jarswaf-bin && \
    rm -rf target /usr/local/cargo/registry /usr/local/cargo/git

# ── Final Runtime Image ─────────────────────────────────────
FROM debian:bookworm-slim
WORKDIR /app

# Minimal runtime: the release binary links libc/libm/libgcc_s only (ring bundles crypto),
# so libssl3 is not needed; curl is unused at runtime. ca-certificates is kept for TLS root
# verification. Create runtime dirs here.
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /var/log/jarswaf /app/certs

# Copy binary
COPY --from=builder /app/jarswaf-bin /app/jarswaf

# NOTE: config.standalone.toml is deliberately NOT baked in — it carries a committed
# admin_token hash into every image. First boot generates its own credential via
# ensure_admin_credentials. Mount one explicitly (--volume) if a fixed setup is required.

# Run as non-root. Binds 80/443 via the ambient capability; the image would need
# `--cap-add=NET_BIND_SERVICE` at runtime for that. `ponytail:` if the runtime ignores
# ambient caps for the CMD binary, setcap the binary instead and drop USER.
RUN useradd --system --no-create-home --shell /usr/sbin/nologin jarswaf && \
    chown -R jarswaf:jarswaf /app /var/log/jarswaf /app/certs

COPY docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

# Entrypoint chowns mounted volumes (as root) then drops to jarswaf for the app process.
# Container default user stays root solely for the chown; the server runs as jarswaf.
ENTRYPOINT ["/app/docker-entrypoint.sh"]

EXPOSE 80 443

ENV RUST_LOG=info

# Run as Agent (no controller flag = standalone mode)
CMD ["/app/jarswaf", "agent"]
