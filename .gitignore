# ==============================================================================
# jarsWAF Project .gitignore
# High-Performance Layer 7 WAF (Rust + eBPF + Svelte Dashboard)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Rust & eBPF Build Artifacts & Temporary Dumps
# ------------------------------------------------------------------------------
/target/
/jarswaf-ebpf/target/
/xtask/target/
**/*.rs.bk
*.tmp
*.tmp*
*.rlib
*.rmeta
*.so
*.dylib
*.dll
*.a
*.o
*.d

# ------------------------------------------------------------------------------
# 2. Frontend & Dashboard (Svelte / Vite / Node)
# ------------------------------------------------------------------------------
/node_modules/
/dashboard/node_modules/
/dashboard/dist/
/dashboard/.svelte-kit/
/dashboard/.vite/
/dashboard/build/
package-lock.json.bak
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 3. WAF Runtime State, Databases, Logs & Backups
# ------------------------------------------------------------------------------
/logs/
/config_backups/
*.log
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
blocklist.json

# ------------------------------------------------------------------------------
# 4. Security, TLS Certificates & Secrets
# ------------------------------------------------------------------------------
/certs/
*.pem
*.crt
*.key
*.csr
*.pfx
*.p12
.env
.env.*
!.env.example
secrets.toml
pentest_lab.toml
pentest*.toml
redteam_lab*.toml

# ------------------------------------------------------------------------------
# 5. External Research / Vendored Sub-repositories
# ------------------------------------------------------------------------------
/external/
__pycache__/
*.pyc
*.pyo

# ------------------------------------------------------------------------------
# 6. IDEs, Editors & System Metadata
# ------------------------------------------------------------------------------
.vscode/
.idea/
.claude/
.gemini/
.DS_Store
Thumbs.db
*.swp
*.swo
IDEA.md