(module
  (memory (export "memory") 1)
  (func (export "inspect_request")
    (param $path_ptr i32) (param $path_len i32)
    (param $query_ptr i32) (param $query_len i32)
    (param $body_ptr i32) (param $body_len i32)
    (result i32)
    (local $i i32)
    (local $end i32)
    ;; path_len >= 5 to match "/admin" (6 chars)
    (if (i32.lt_s (local.get $path_len) (i32.const 5))
      (then (return (i32.const 0)))
    )
    ;; end = path_len - 5
    (local.set $end (i32.sub (local.get $path_len) (i32.const 5)))
    (local.set $i (i32.const 0))
    (block $break
      (loop $loop
        (br_if $break (i32.ge_s (local.get $i) (local.get $end)))
        ;; Check path[i..i+6] == "/admin"
        (if (i32.and
              (i32.and
                (i32.eq (i32.load8_u (i32.add (local.get $path_ptr) (local.get $i))) (i32.const 47))
                (i32.eq (i32.load8_u (i32.add (local.get $path_ptr) (i32.add (local.get $i) (i32.const 1)))) (i32.const 97))
              )
              (i32.and
                (i32.eq (i32.load8_u (i32.add (local.get $path_ptr) (i32.add (local.get $i) (i32.const 2)))) (i32.const 100))
                (i32.eq (i32.load8_u (i32.add (local.get $path_ptr) (i32.add (local.get $i) (i32.const 3)))) (i32.const 109))
              )
            )
          (then
            (if (i32.and
                  (i32.eq (i32.load8_u (i32.add (local.get $path_ptr) (i32.add (local.get $i) (i32.const 4)))) (i32.const 105))
                  (i32.eq (i32.load8_u (i32.add (local.get $path_ptr) (i32.add (local.get $i) (i32.const 5)))) (i32.const 110))
                )
              (then (return (i32.const 1)))
            )
          )
        )
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop)
      )
    )
    (i32.const 0)
  )
)
